# Copie este arquivo para `.env` (na raiz do repositório) e preencha.
# O `.env` é ignorado pelo git: nada daqui sai da sua máquina.
# A skill /setup preenche tudo isso conversando com você — não precisa editar na mão.

# Subdomínio da sua base no Sienge: é o começo do endereço que você usa pra entrar.
# Ex.: se você entra em https://minhaempresa.sienge.com.br, o subdomínio é "minhaempresa".
SIENGE_SUBDOMINIO=

# Usuário de API criado em Integrações > APIs > Usuários de APIs (começa com "<subdominio>-").
SIENGE_USUARIO_API=

# Senha gerada pelo Sienge ao salvar o usuário de API (aparece uma vez só).
SIENGE_SENHA_API=

# Código da empresa (devedora) padrão dos lançamentos. O /setup lista as suas empresas e preenche.
SIENGE_EMPRESA_PADRAO=

# Código do tipo de documento usado nos lançamentos (ex.: NF). O /setup confere quais existem na sua base.
SIENGE_DOCUMENTO_PADRAO=NF

# Código do indexador padrão dos títulos (normalmente o "Real"). O /setup lista e preenche.
SIENGE_INDEXADOR_PADRAO=

# Opcional: plano financeiro usado quando nenhuma regra nem histórico sugerir um (sem máscara, ex.: 2010101).
SIENGE_PLANO_FINANCEIRO_PADRAO=
